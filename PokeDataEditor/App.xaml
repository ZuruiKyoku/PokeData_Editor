<Application x:Class="PokeDataEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PokeDataEditor"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:StringListConverter x:Key="StringListConverter"/>
        <local:IntListConverter x:Key="IntListConverter"/>
        <local:LevelUpListConverter x:Key="LevelUpListConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Application.Resources>
</Application>
